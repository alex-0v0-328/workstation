{
  "name": "workstation",
  "version": "0.4.0",
  "private": true,
  "description": "A local-first Windows workspace for tasks, study, and mail.",
  "author": "Alex",
  "license": "UNLICENSED",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && node scripts/package.cjs",
    "postinstall": "electron-builder install-app-deps",
    "smoke": "node scripts/smoke.cjs"
  },
  "build": {
    "appId": "io.github.alex0v0328.workstation",
    "productName": "Workstation",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        "nsis",
        "msi"
      ],
      "signAndEditExecutable": true,
      "icon": "resources/icon.ico",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "sign": "scripts/sign.cjs"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "msi": {
      "upgradeCode": "7f3a9c2e-4b6d-4e1a-9c5f-2d8b0a1e6f3d"
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "ical.js": "^2.2.1",
    "luxon": "^3.7.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fluentui/react-components": "^9.74.7",
    "@fluentui/react-icons": "^2.0.341",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "dompurify": "^3.4.15",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
}
